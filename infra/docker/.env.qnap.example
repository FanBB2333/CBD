# All bind mount sources are absolute paths ON THE QNAP, not on the build Mac.
VERSION=qnap
CELLBRIDGE_CONFIG=/share/Container/cbd/config.yaml
CELLBRIDGE_DATA_DIR=/share/Container/cbd/data
CELLBRIDGE_RUNTIME_DIR=/share/Container/cbd/module-voice
CELLBRIDGE_SMS_DRY_RUN=true
# Optional mirror; affects only this image build, not QNAP's Docker daemon.
