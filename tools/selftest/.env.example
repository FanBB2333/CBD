# Copy to .env (git-ignored) and fill in. Environment variables take precedence.
# Address the gateway's sip.listen binds to, usually the NAS Tailscale address.
SIP_SERVER=100.64.0.10:5060
SIP_DOMAIN=cellbridge-nas.example.ts.net
SIP_USER=iphone
# Keep the password out of files: export SIP_PASS (e.g. from ~/.secrets.zsh).
